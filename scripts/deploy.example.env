# Copy to scripts/deploy.<target>.env (e.g. deploy.live.env); those files are not in git.
DEPLOY_HOST=203.0.113.10
DEPLOY_PORT=65002
DEPLOY_USER=u000000000
# Private SSH key whose public key is added in hPanel → Advanced → SSH Access.
DEPLOY_KEY=$HOME/.ssh/orlena_live
# The Laravel folder relative to the SSH home; public_html points to its public/ folder.
DEPLOY_APP_DIR=domains/example.com/orlena
