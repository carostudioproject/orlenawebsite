APP_NAME=Orlena
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
SITE_INDEXABLE=false
META_PIXEL_ENABLED=false
WHATSAPP_NUMBER=6282145809558

# Backend-only DOKU Checkout credentials (sandbox first). In DOKU Back Office set the Notification URL
# (and the Checkout expired notification URL) to {APP_URL}/webhooks/doku.
# false until DOKU is set up: staff then mark orders as paid manually.
DOKU_ENABLED=false
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_IS_PRODUCTION=false
DOKU_TIMEOUT=20
# qris = Orlena payment page with a QRIS (DOKU QRIS Direct API, SNAP); checkout = DOKU hosted Checkout page.
DOKU_MODE=qris
# From DOKU after QRIS registration is approved. QRIS Notification URL: {APP_URL}/webhooks/doku-qris
DOKU_QRIS_MERCHANT_ID=
DOKU_QRIS_TERMINAL_ID=
DOKU_QRIS_POSTAL_CODE=80361
# Our RSA private key for SNAP (upload the matching public key in DOKU). Default: storage/app/private/doku-snap-private.pem
DOKU_SNAP_PRIVATE_KEY_PATH=
# Only if DOKU issues a separate SNAP client secret; otherwise DOKU_SECRET_KEY is used.
DOKU_SNAP_CLIENT_SECRET=

# Erzap (OLZAP API): paid orders are sent to {ERZAP_BASE_URL}{ERZAP_ORDER_PATH} by `php artisan erzap:sync`
# (scheduled every 5 minutes). Values come from Erzap; keep ERZAP_ENABLED=false until all of them are filled.
ERZAP_ENABLED=false
# e.g. https://domain_erzap:4443
ERZAP_BASE_URL=
ERZAP_TOKEN=
ERZAP_ORDER_PATH=/apis/simpan_pesanan_penjualan
# idoutlet_penerima_pesanan_online_erzap for outlets without their own Erzap outlet ID in Mapping.
ERZAP_DEFAULT_OUTLET_ID=
# iduser_sales_penerima_pesanan_online_erzap
ERZAP_SALES_USER_ID=
ERZAP_TIMEOUT=20
# true: send our Order Code as "kode". false: send null so Erzap gives its own number (Order Code stays in the note).
ERZAP_SEND_ORDER_CODE=true

# REST API (/api/v1): comma-separated long random tokens for integrations. Empty = protected endpoints closed.
API_TOKENS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database


BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orlena
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
